# Resend API key. Keep the real key in .env.local or Vercel environment settings.
RESEND_API_KEY=re_your_api_key

# Address that receives portfolio contact messages.
CONTACT_EMAIL=you@example.com

# A sender address on a domain verified with Resend.
CONTACT_FROM_EMAIL=Portfolio <hello@your-verified-domain.com>

# Optional public canonical URL. If unset, Vercel's deployment URL is used.
# Set this to your custom domain when one is connected.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
